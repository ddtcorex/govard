{
  "_shared": {
    "sync": {
      "global_noise_excludes": [
        ".git/",
        ".idea/",
        ".vscode/",
        ".DS_Store",
        "thumbs.db",
        "node_modules/"
      ],
      "sensitive_path_excludes": [
        ".env",
        "*.pem",
        "*.key",
        "auth.json"
      ],
      "fallback_noise_excludes": [
        "var/log/",
        "var/cache/",
        "logs/",
        "cache/"
      ],
      "media_common_excludes": [
        "*.gz",
        "*.zip",
        "*.tar",
        "*.7z",
        "*.sql",
        "*.tmp",
        "*.temp",
        "*.bak",
        "*.old",
        "*.log",
        "*tmp*/",
        "*temp*/",
        "*cache*/",
        "*bak*/",
        "*old*/",
        "*log*/",
        "*session*/"
      ],
      "media_fallback_non_all_excludes": [
        "cache/",
        "tmp/",
        "logs/"
      ],
      "media_minimal_excludes": [
        "*.jpg",
        "*.jpeg",
        "*.png",
        "*.gif",
        "*.webp",
        "*.svg",
        "*.ico",
        "*.mp4",
        "*.mov",
        "*.webm",
        "*.ogv",
        "*.mp3",
        "*.pdf"
      ]
    }
  },
  "frameworks": {
    "custom": {
      "paths": {
        "local_media": "public/media",
        "remote_media": "public/media",
        "web_root_candidates": []
      },
      "features": {
        "requires_running_env_for_fresh_install": true,
        "supports_post_clone": false
      },
      "ignored": [],
      "sensitive": []
    }
  }
}
