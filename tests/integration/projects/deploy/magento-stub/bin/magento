<?php
/**
 * A Magento CLI stub that verifies the arguments the recipe builds instead of
 * pretending to compile assets.
 *
 * The expectation is read from deploy-expectation.txt, which the test writes
 * before seeding the origin, so one stub covers the split and the single-pass
 * mode. A text assertion cannot tell which branch of a shell conditional ran —
 * only running it can — which is why this replaces one.
 */

$release = dirname(__DIR__);
$expectation = trim((string) @file_get_contents($release . '/deploy-expectation.txt'));
if ($expectation === '') {
    $expectation = 'single';
}

$log = $release . '/var/stub-calls.log';
if (!is_dir($release . '/var')) {
    mkdir($release . '/var', 0777, true);
}

$arguments = array_slice($argv, 1);
file_put_contents($log, implode(' ', $arguments) . "\n", FILE_APPEND);

$fail = static function (string $message): void {
    fwrite(STDERR, "magento stub: {$message}\n");
    exit(1);
};

$calls = static function (string $needle) use ($log): int {
    $contents = (string) @file_get_contents($log);

    return substr_count($contents, $needle);
};

$command = $arguments[0] ?? '';

if ($command === 'setup:static-content:deploy') {
    $area = 'none';
    foreach ($arguments as $argument) {
        if (str_starts_with($argument, '--area=')) {
            $area = substr($argument, strlen('--area='));
        }
    }
    if ($expectation === 'split') {
        if ($area === 'adminhtml') {
            if ($calls('setup:static-content:deploy') !== 1) {
                $fail('the adminhtml pass must come first');
            }
            if ($calls('--area=frontend') !== 0) {
                $fail('the frontend pass must come after the adminhtml pass');
            }
        } elseif ($area === 'frontend') {
            if ($calls('--area=adminhtml') !== 1) {
                $fail('the frontend pass must follow exactly one adminhtml pass');
            }
        } else {
            $fail("the split must name an area, got '{$area}'");
        }
    } elseif ($area !== 'none') {
        $fail("without split_static_deployment there must be no --area, got '{$area}'");
    }
}

if ($command === 'maintenance:enable' || $command === 'maintenance:disable') {
    // Maintenance mode is read by the application the web server serves, so the
    // step must run in *that* directory: the docroot, never the release being
    // built. A flag written into the incoming release protects nothing while the
    // schema is migrated and takes the site down when the release goes live.
    $served = trim((string) @file_get_contents($release . '/served-path.txt'));
    if ($served === '') {
        $fail('served-path.txt is missing, so the test cannot say where the site is served from');
    }
    if (realpath(getcwd()) !== realpath($served)) {
        $fail("{$command} ran in '" . getcwd() . "' instead of the served directory '{$served}'");
    }
    if ($command === 'maintenance:enable') {
        @mkdir('var', 0777, true);
        file_put_contents('var/.maintenance.flag', "maintenance\n");
    } else {
        @unlink('var/.maintenance.flag');
    }
}

if ($command === 'setup:db:status') {
    // The verify stage runs last, so this is where "the static content step never
    // ran at all" is caught rather than assumed.
    $deploys = $calls('setup:static-content:deploy');
    $expected = $expectation === 'split' ? 2 : 1;
    if ($deploys !== $expected) {
        $fail("expected {$expected} static content pass(es), saw {$deploys}");
    }

    // The frontend build: `frontend_dir` names the theme Tailwind directories and
    // the default `frontend_command` builds each one in place. The expectation file
    // names which directories must have been built.
    $frontend = trim((string) @file_get_contents($release . '/frontend-expectation.txt'));
    $built = trim((string) @file_get_contents($release . '/var/frontend-built.txt'));
    $recorded = $built === '' ? [] : preg_split('/\R/', $built);

    $expectedBuilds = [
        'hyva' => ['app/design/frontend/Acme/hyva/web/tailwind'],
        'hyva-multi' => [
            'app/design/frontend/Acme/hyva/web/tailwind',
            'app/design/frontend/Acme/other/web/tailwind',
        ],
    ];

    if ($frontend === '') {
        if ($recorded !== []) {
            $fail('a project without frontend_dir must not build a theme');
        }
    } elseif (!isset($expectedBuilds[$frontend])) {
        $fail("unknown frontend expectation '{$frontend}'");
    } else {
        $wanted = $expectedBuilds[$frontend];
        if (count($recorded) !== count($wanted)) {
            $fail('expected ' . count($wanted) . ' frontend build(s), saw ' . count($recorded));
        }
        foreach ($wanted as $index => $suffix) {
            if (!str_ends_with($recorded[$index], $suffix)) {
                $fail("frontend build {$index} ran in '{$recorded[$index]}' instead of '{$suffix}'");
            }
        }
    }
}

exit(0);
