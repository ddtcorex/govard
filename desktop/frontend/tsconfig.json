{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["types/**/*.d.ts", "services/**/*.js", "main.js", "modules/**/*.js", "state/**/*.js", "ui/**/*.js", "utils/**/*.js"]
}
