<?php
/**
 * A Magento CLI stub that verifies the arguments the recipe builds instead of
 * pretending to compile assets.
 *
 * The expectation is read from deploy-expectation.txt, which the test writes
 * before seeding the origin, so one stub covers the split and the single-pass
 * mode. A text assertion cannot tell which branch of a shell conditional ran —
 * only running it can — which is why this replaces one.
 */

$release = dirname(__DIR__);
$expectation = trim((string) @file_get_contents($release . '/deploy-expectation.txt'));
if ($expectation === '') {
    $expectation = 'single';
}

// The records the test asserts on live outside both trees, at an absolute path
// named by stub-state-dir.txt. The build steps run in the release while the
// verify check runs in the *served* path — on an in-place target a different
// directory — so a record kept under either tree's `var/` is invisible to the
// other. Without that file the stub keeps its records in the release's `var/`,
// which is what a symlink target needs anyway.
$state = trim((string) @file_get_contents($release . '/stub-state-dir.txt'));
if ($state === '') {
    $state = $release . '/var';
}
if (!is_dir($state)) {
    mkdir($state, 0777, true);
}

$log = $state . '/stub-calls.log';

$arguments = array_slice($argv, 1);
file_put_contents($log, implode(' ', $arguments) . "\n", FILE_APPEND);

$fail = static function (string $message): void {
    fwrite(STDERR, "magento stub: {$message}\n");
    exit(1);
};

$calls = static function (string $needle) use ($log): int {
    $contents = (string) @file_get_contents($log);

    return substr_count($contents, $needle);
};

$command = $arguments[0] ?? '';

if ($command === 'setup:static-content:deploy') {
    $area = 'none';
    foreach ($arguments as $argument) {
        if (str_starts_with($argument, '--area=')) {
            $area = substr($argument, strlen('--area='));
        }
    }
    if ($expectation === 'split') {
        if ($area === 'adminhtml') {
            if ($calls('setup:static-content:deploy') !== 1) {
                $fail('the adminhtml pass must come first');
            }
            if ($calls('--area=frontend') !== 0) {
                $fail('the frontend pass must come after the adminhtml pass');
            }
        } elseif ($area === 'frontend') {
            if ($calls('--area=adminhtml') !== 1) {
                $fail('the frontend pass must follow exactly one adminhtml pass');
            }
        } else {
            $fail("the split must name an area, got '{$area}'");
        }
    } elseif ($area !== 'none') {
        $fail("without split_static_deployment there must be no --area, got '{$area}'");
    }
}

if ($command === 'setup:di:compile') {
    // What an in-place activation is supposed to publish: a path the build created
    // that the docroot's git checkout cannot contain (it is gitignored), so its
    // presence in the docroot afterwards can only come from the sync.
    @mkdir('generated', 0777, true);
    file_put_contents('generated/.deploy-marker', 'built-' . uniqid('', true) . "\n");
}

if ($command === 'maintenance:enable' || $command === 'maintenance:disable') {
    // Maintenance mode is read by the application the web server serves, so the
    // step must run in *that* directory: the docroot, never the release being
    // built. A flag written into the incoming release protects nothing while the
    // schema is migrated and takes the site down when the release goes live.
    $served = trim((string) @file_get_contents($release . '/served-path.txt'));
    if ($served === '') {
        $fail('served-path.txt is missing, so the test cannot say where the site is served from');
    }
    if (realpath(getcwd()) !== realpath($served)) {
        $fail("{$command} ran in '" . getcwd() . "' instead of the served directory '{$served}'");
    }
    if ($command === 'maintenance:enable') {
        @mkdir('var', 0777, true);
        file_put_contents('var/.maintenance.flag', "maintenance\n");
    } else {
        @unlink('var/.maintenance.flag');
    }
}

// `setup:backup --db` is what the recipe's db:backup step calls when the deploy
// asks for a database dump. Real Magento writes `<timestamp>_db.sql` (`.sql.gz`
// only with backup compression configured), and the recipe's command used to look
// for `*.gz` alone — so the stub writes what the tool writes, and the integration
// suite fails if the command stops finding it.
if ($command === 'setup:backup') {
    $backupExpectation = trim((string) @file_get_contents($release . '/backup-expectation.txt'));
    $suffix = $backupExpectation === 'compressed' ? '_db.sql.gz' : '_db.sql';
    $directory = $release . '/var/backups';
    if (!is_dir($directory)) {
        mkdir($directory, 0777, true);
    }
    file_put_contents($directory . '/' . time() . $suffix, "dump\n");
    exit(0);
}

// `setup:rollback --db-file` is not "import this file": Magento validates the name
// against /[0-9]_db.*\.sql$/ and looks the file up inside the release's
// var/backups/. The stub enforces exactly that contract, so a restore command
// that regresses to an absolute path ends the deploy with Magento's own words.
if ($command === 'setup:rollback') {
    $dbFile = '';
    foreach ($arguments as $argument) {
        if (str_starts_with($argument, '--db-file=')) {
            $dbFile = substr($argument, strlen('--db-file='));
        }
    }
    if ($dbFile === '' || preg_match('/[0-9]_db.*\.sql$/', $dbFile) !== 1) {
        $fail("setup:rollback was given '{$dbFile}'; Magento rejects a name that does not match /[0-9]_db.*\\.sql$/");
    }
    if (!is_file($release . '/var/backups/' . $dbFile)) {
        $fail("setup:rollback must be given a name inside var/backups; '{$dbFile}' is not there");
    }
    file_put_contents($log, 'setup:rollback ' . $dbFile . "\n", FILE_APPEND);
    exit(0);
}

if ($command === 'setup:db:status') {
    // The check exists to answer for the application the web server serves, so
    // it has to run there: on an in-place target that is not the release the
    // build ran in, and a schema check against the release reports on an
    // application nothing is serving yet. Same assertion as the maintenance
    // window, for the same reason.
    $served = trim((string) @file_get_contents($release . '/served-path.txt'));
    if ($served === '') {
        $fail('served-path.txt is missing, so the test cannot say where the site is served from');
    }
    if (realpath(getcwd()) !== realpath($served)) {
        $fail("the application check ran in '" . getcwd() . "' instead of the served directory '{$served}'");
    }

    // This check runs in the served path, so on an in-place target `$release` is
    // the docroot: the marker below is the one the activation *copied in*, and a
    // missing one means the build produced nothing for the docroot to serve.
    // Comparing the two values proves nothing any more — they are the same file
    // — which is why the engine dry-runs the whole sync path instead
    // (`TestVerifyInPlaceCatchesADocrootThatDiffersFromTheRelease`).
    $sync = trim((string) @file_get_contents($release . '/sync-expectation.txt'));
    if ($sync === 'generated') {
        $built = trim((string) @file_get_contents($release . '/generated/.deploy-marker'));
        $published = trim((string) @file_get_contents($served . '/generated/.deploy-marker'));
        if ($built === '') {
            $fail('the served generated/.deploy-marker is missing: setup:di:compile produced nothing, or the activation copied nothing');
        }
        if ($published !== $built) {
            $fail("the docroot's generated/.deploy-marker is '{$published}', not the built '{$built}'");
        }
    }

    // The verify stage runs last, so this is where "the static content step never
    // ran at all" is caught rather than assumed.
    $deploys = $calls('setup:static-content:deploy');
    $expected = $expectation === 'split' ? 2 : 1;
    if ($deploys !== $expected) {
        $fail("expected {$expected} static content pass(es), saw {$deploys}");
    }

    // The frontend build: `frontend_dir` names the theme Tailwind directories and
    // the default `frontend_command` builds each one in place. The expectation file
    // names which directories must have been built.
    $frontend = trim((string) @file_get_contents($release . '/frontend-expectation.txt'));
    $built = trim((string) @file_get_contents($state . '/frontend-built.txt'));
    $recorded = $built === '' ? [] : preg_split('/\R/', $built);

    $expectedBuilds = [
        'hyva' => ['app/design/frontend/Acme/hyva/web/tailwind'],
        'hyva-multi' => [
            'app/design/frontend/Acme/hyva/web/tailwind',
            'app/design/frontend/Acme/other/web/tailwind',
        ],
    ];

    if ($frontend === '') {
        if ($recorded !== []) {
            $fail('a project without frontend_dir must not build a theme');
        }
    } elseif (!isset($expectedBuilds[$frontend])) {
        $fail("unknown frontend expectation '{$frontend}'");
    } else {
        $wanted = $expectedBuilds[$frontend];
        if (count($recorded) !== count($wanted)) {
            $fail('expected ' . count($wanted) . ' frontend build(s), saw ' . count($recorded));
        }
        foreach ($wanted as $index => $suffix) {
            if (!str_ends_with($recorded[$index], $suffix)) {
                $fail("frontend build {$index} ran in '{$recorded[$index]}' instead of '{$suffix}'");
            }
        }
    }
}

exit(0);
